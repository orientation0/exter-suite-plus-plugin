    def _call_method(self, obj, names, *args):
        if obj is None:
            return None
        for name in names:
            try:
                fn = getattr(obj, name, None)
                if fn is None:
                    continue
                return fn(*args)
            except Exception:
                continue
        return None

    def _get_attr(self, obj, names):
        if obj is None:
            return None
        for name in names:
            try:
                value = getattr(obj, name, None)
                if value is not None:
                    return value
            except Exception:
                continue
        return None

    def _try_call(self, obj, names, *args):
        if obj is None:
            return False
        for name in names:
            try:
                fn = getattr(obj, name, None)
                if fn is None:
                    continue
                fn(*args)
                return True
            except Exception:
                try:
                    fn = getattr(obj, name, None)
                    if fn is not None:
                        fn()
                        return True
                except Exception:
                    pass
        return False