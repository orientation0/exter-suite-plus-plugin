def as_java_color(color: int) -> int:
    value = int(color) & 0xFFFFFFFF
    return value - 0x100000000 if value >= 0x80000000 else value


def clamp(value, lo, hi):
    if hi < lo:
        return lo
    return lo if value < lo else hi if value > hi else value


def parse_duration(text: str):
    m = re.fullmatch(r"(\d+)([smhd])", str(text).strip().lower())
    if not m:
        return None
    n = int(m.group(1))
    unit = m.group(2)
    mult = {"s": 1, "m": 60, "h": 3600, "d": 86400}.get(unit, 0)
    return n * mult if mult else None


def normalize_text(s: str) -> str:
    s = str(s or "").lower()
    s = re.sub(r"[^\w\s]", "", s)
    s = re.sub(r"\s+", " ", s).strip()
    return s


class _OnClickListener(dynamic_proxy(View.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, view):
        try:
            self.fn()
        except Exception as e:
            log(f"[{__id__}] click error: {e}")


class _FabTouchListener(dynamic_proxy(View.OnTouchListener)):
    def __init__(self, plugin):
        super().__init__()
        self.plugin = plugin

    def onTouch(self, view, event):
        try:
            return bool(self.plugin._on_fab_touch(event))
        except Exception as e:
            log(f"[{__id__}] fab touch error: {e}")
            return False


class ExterSuitePlugin(BasePlugin):
    def __init__(self):
        super().__init__()
        self._handler = None
        self._tick_r = None
        self._running = False
        self._paused = False
        self._unloaded = False
        self._cfg = {}

        self._decor = None
        self._fab = None
        self._status = None
        self._panel = None
        self._panel_log = None
        self._panel_listeners = []
        self._lock = None
        self._lock_input = None
        self._lock_listeners = []
        self._fab_touch = None

        self._reset_state()

    def on_plugin_load(self):
        self._reload_cfg()
        self._handler = Handler(Looper.getMainLooper())
        self._tick_r = R(self._tick)

        self.add_menu_item(
            MenuItemData(
                menu_type=MenuItemType.DRAWER_MENU,
                text="Exter Suite",
                on_click=self._on_menu_toggle,
                item_id="exter_suite_toggle",
                icon="msg_photo_settings",
            )
        )
        self.add_on_send_message_hook()
        run_on_ui_thread(lambda: self._start(greet=True))

    def on_plugin_unload(self):
        self._unloaded = True
        self._running = False
        if self._handler is not None and self._tick_r is not None:
            self._handler.removeCallbacks(self._tick_r)
        self._on_ui(self._detach_views)

    def on_app_event(self, event_type):
        if event_type == "PAUSE":
            self._paused = True
            if self._handler is not None and self._tick_r is not None:
                self._handler.removeCallbacks(self._tick_r)
        elif event_type == "RESUME":
            self._paused = False
            run_on_ui_thread(lambda: self._start(greet=False))

    def on_send_message_hook(self, account, params):
        try:
            text = str(getattr(params, "message", "") or "")
            if text and not text.startswith(REPLY_MARK):
                if self._cfg.get("commands", True) and text.startswith(PREFIX):
                    self._handle_command(account, text)
                if self._cfg.get("strip_metadata", True):
                    self._strip_params(params)
        except Exception as e:
            log(f"[{__id__}] send hook error: {e}")
        return HookResult()

